# Private PostgreSQL runtime defaults to .pgsock, port 55432.
PGDATABASE=accessledger_demo
PGPORT=55432
PGUSER=postgres
# PGHOST=127.0.0.1
# PGPASSWORD=local-owner-only
# Override for TCP/Compose; application never connects as postgres.
APP_DB_USER=accessledger_demo_app
APP_DB_PASSWORD=local-demo-only
# DATABASE_URL=postgresql+psycopg://accessledger_demo_app:local-demo-only@127.0.0.1:55432/accessledger_demo
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

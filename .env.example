# AccessLedger — local database connection settings.
#
# scripts/db-env.sh exports the defaults below, so a plain checkout needs no
# .env at all. Copy to .env only if you need to override something.

# Port for the project-local cluster. Deliberately not 5432 so it cannot
# collide with any system-wide PostgreSQL.
ACCESSLEDGER_PGPORT=55432

# Superuser of the project-local cluster, created by bootstrap-postgres.sh.
ACCESSLEDGER_PGUSER=postgres

# Set by scripts/db-env.sh; shown here for the tests and the future backend.
# The cluster listens on a unix socket only (listen_addresses = ''), with
# trust authentication, so there is no password to store.
# PGHOST=/absolute/path/to/AccessLedger/.pgsock
# PGPORT=55432
# PGUSER=postgres
# PGDATABASE=accessledger